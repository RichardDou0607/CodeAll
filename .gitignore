# build artifacts / dependencies
node_modules/
dist/
target/
**/target/
*.app/
.DS_Store
*.log

# bundled service staging (apps/shell/src-tauri/resources/app — 含复制的 node 二进制，构建时生成)
apps/shell/src-tauri/resources/

