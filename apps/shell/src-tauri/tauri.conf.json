{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPet",
  "version": "0.1.0",
  "identifier": "com.agentpet.shell",
  "build": {
    "frontendDist": "../webui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent 悬浮窗 · 启动中",
        "width": 360,
        "height": 340,
        "minWidth": 360,
        "minHeight": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}