{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeAll",
  "version": "0.1.0",
  "identifier": "com.agentpet.shell",
  "build": {
    "frontendDist": "../webui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CodeAll · 迷你条",
        "width": 380,
        "height": 96,
        "minWidth": 320,
        "minHeight": 48,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "app",
        "title": "CodeAll · App",
        "url": "app.html",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "shadow": true,
        "resizable": true,
        "visible": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
